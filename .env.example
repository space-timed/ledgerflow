# LedgerFlow Environment Variables Configuration
# Copy this file to .env for local customized overrides

# Application
COMPOSE_PROJECT_NAME=ledgerflow
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ledgerflow
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_secret

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# Security & Sandbox Admin Token (for initializing test merchants)
SANDBOX_ADMIN_SECRET=sandbox_master_key_9981

# Webhooks
WEBHOOK_DISPATCHER_ENABLED=true
WEBHOOK_MAX_RETRIES=3
WEBHOOK_CONNECT_TIMEOUT_MS=3000
WEBHOOK_READ_TIMEOUT_MS=5000
