      "title": "Payment Rate (req/sec)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(ledgerflow_payments_total[1m]))",
